{
  "manifest_version": 3,
  "name": "Yazıcı Paneli",
  "description": "Canon G3010 için Chrome yazdırma hedefi: Yazıcı Paneli uygulamasındaki sabit baskı ayarlarıyla basar.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "printerProvider",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "arkaplan.js"
  },
  "action": {
    "default_title": "Yazıcı Paneli",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "simgeler/simge-16.png",
      "32": "simgeler/simge-32.png",
      "48": "simgeler/simge-48.png",
      "128": "simgeler/simge-128.png"
    }
  },
  "icons": {
    "16": "simgeler/simge-16.png",
    "32": "simgeler/simge-32.png",
    "48": "simgeler/simge-48.png",
    "128": "simgeler/simge-128.png"
  }
}
